SELECT
  r.internalSupplierId,  
  -- Retrieves the internal supplier ID from the `RelationshipSpendLineItems` table.

  ARRAY_TO_STRING(og.domains, "|") AS domains,  
  -- Converts the `domains` array into a string separated by "|".

  og.name,  
  -- Retrieves the supplier's name from the `OrgUnit` table.

  og.supplier.locations[SAFE_OFFSET(0)].address AS Primary_Address,  
  -- Extracts the primary address from the supplier's locations array (first element, if available).

  offering.value  
  -- Retrieves the value of each supplier's offerings.

FROM
  `tealbook-prd.tealbook.RelationshipSpendLineItems` r  
  -- Main table containing spend transactions.

JOIN 
  `tealbook-prd.tealbook.Relationship` AS Rel  
ON 
  SUBSTR(r.__key__.path, 0, 86) = Rel.__key__.path  
  -- Joins `RelationshipSpendLineItems` with `Relationship` by matching key path substrings.

LEFT JOIN
  `tealbook-prd.tealbook.OrgUnit` og  
ON
  SUBSTR(r.supplier, 9, 16) = SUBSTR(og.__key__.path, 8, 16)
  AND RIGHT(r.supplier, 16) = SUBSTR(og.__key__.path, 37, 16)  
  -- Joins `OrgUnit` to fetch supplier details by matching extracted substrings.

, UNNEST(og.supplier.offerings) AS offering  
-- Unnests the supplier's offerings array to retrieve individual values.

WHERE
  -- Filters records by specific organization ID and unit ID.
  SUBSTR(r.__key__.path, 8, 16) = '4953680927260672'
  AND SUBSTR(r.__key__.path, 37, 16) = '5629499534213120';
